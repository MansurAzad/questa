# Supabase — browser-exposed configuration (safe to publish: publishable/anon key only).
# Get these from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Server-only values (NEVER expose to the browser, never prefix with VITE_).
# Used for provisioning/migrations, not by the app at runtime.
# ---------------------------------------------------------------------------
# SUPABASE_DB_URI="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJI..."
